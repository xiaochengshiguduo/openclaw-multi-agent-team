{
  "version": "1.1.0",
  "description": "Add safe runtime workspace updater and managed runtime templates.",
  "files": [
    {
      "source": "roles/main/AGENTS.md",
      "target": "workspace/AGENTS.md",
      "strategy": "managed-overwrite",
      "kind": "workspace",
      "sources": {
        "en": "roles/main/AGENTS.md",
        "zh-CN": "roles/main/AGENTS.zh-CN.md"
      }
    },
    {
      "source": "workspace-template/TEAM.md",
      "target": "workspace/TEAM.md",
      "strategy": "managed-overwrite",
      "kind": "workspace",
      "sources": {
        "en": "workspace-template/TEAM.md",
        "zh-CN": "workspace-template/TEAM.zh-CN.md"
      }
    },
    {
      "source": "task-templates/_template/main-supervisor-sop.md",
      "target": "workspace/shared/tasks/_template/main-supervisor-sop.md",
      "strategy": "managed-overwrite",
      "kind": "task-templates",
      "sources": {
        "en": "task-templates/_template/main-supervisor-sop.md",
        "zh-CN": "task-templates/_template/main-supervisor-sop.zh-CN.md"
      }
    },
    {
      "source": "task-templates/_template/status.md",
      "target": "workspace/shared/tasks/_template/status.md",
      "strategy": "managed-overwrite",
      "kind": "task-templates",
      "sources": {
        "en": "task-templates/_template/status.md",
        "zh-CN": "task-templates/_template/status.zh-CN.md"
      }
    },
    {
      "source": "task-templates/_template/subagents.md",
      "target": "workspace/shared/tasks/_template/subagents.md",
      "strategy": "create-or-managed-overwrite",
      "kind": "task-templates",
      "sources": {
        "en": "task-templates/_template/subagents.md",
        "zh-CN": "task-templates/_template/subagents.zh-CN.md"
      }
    }
  ],
  "restart": {
    "default": true,
    "reason": "Reload updated workspace instructions and task templates."
  }
}
