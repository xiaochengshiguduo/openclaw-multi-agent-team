{
  agents: {
    list: [{
      id: "main",
      subagents: {
        allowAgents: [
          "pm", "architect", "backend", "frontend", "qa",
          "reviewer", "security", "devops", "docs", "research"
        ]
      }
    }]
  },
  tools: {
    agentToAgent: {
      enabled: true,
      allow: [
        "main", "pm", "architect", "backend", "frontend", "qa",
        "reviewer", "security", "devops", "docs", "research"
      ]
    },
    sessions: {
      visibility: "all"
    }
  },
  session: {
    agentToAgent: {
      maxPingPongTurns: 2
    }
  }
}
